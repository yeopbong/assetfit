    "image": {
      "width": 512,
      "height": 512,
      "dpr": 1,
      "fit": "contain",
      "weight": 1,
      "regions": []
    },
    "glb": {
      "width": 256,
      "height": 256,
      "dpr": 1,
      "fit": "contain",
      "weight": 1,
      "regions": []
    },
    "constraints": {
      "preserveAlpha": true,
      "formats": [
        "jpeg",
        "png",
        "webp"
      ]
    }
  }
}