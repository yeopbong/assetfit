{
  "schemaVersion": 1,
  "kind": "policy",
  "version": "assetfit-0.1.0",
  "budgets": [
    {
      "name": "lite",
      "bytes": 5500000
    },
    {
      "name": "standard",
      "bytes": 7000000
    },
    {
      "name": "high",
      "bytes": 9000000
